# Copy this file to .env and fill in your own keys.
# Never commit real tokens.

GITHUB_MODELS_API_KEY=
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Comma-separated model IDs shown in the UI model picker
ALLOWED_MODELS=gpt-5,gpt-5-mini,gpt-5-nano,gpt-4o,gpt-4o-mini,gpt-4.1,gpt-4.1-mini,gpt-4.1-nano,meta-llama-3.1-8b-instruct,meta-llama-3.1-405b-instruct,codestral-2501,ministral-3b,phi-4,deepseek-r1,grok-3,grok-3-mini
MODEL_STRICT_ALLOWLIST=true

HUGGING_FACE_API_KEY=
HUGGING_FACE_IMAGE_MODELS=Qwen/Qwen-Image

# Optional per-model context windows with model:window format
MODEL_CONTEXT_WINDOWS=gpt-4o-mini:128000,gpt-4.1-mini:128000,claude-3.7-sonnet:200000

IMAGE_ALLOWED_MODELS=gpt-image-1
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image
GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts
DEFAULT_IMAGE_SIZE=1024x1024

# App settings
DATABASE_PATH=chatbot.db
APP_HOST=127.0.0.1
APP_PORT=8000
REQUEST_TIMEOUT_SECONDS=90
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
