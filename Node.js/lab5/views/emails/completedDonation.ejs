<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Donation Completed</title>
</head>
<body style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
	<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f4f7fb;padding:24px 0;">
		<tr>
			<td align="center">
				<table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,0.08);">
					<tr>
						<td style="background:#16a34a;padding:28px 32px;color:#ffffff;">
							<h1 style="margin:0;font-size:24px;line-height:1.3;">Thank You for Your Donation</h1>
							<p style="margin:8px 0 0;font-size:15px;opacity:0.95;">Your contribution has been successfully completed.</p>
						</td>
					</tr>
					<tr>
						<td style="padding:32px;">
							<p style="margin:0 0 16px;font-size:16px;line-height:1.6;">Hello <strong><%= locals.name || 'Supporter' %></strong>,</p>
							<p style="margin:0 0 20px;font-size:15px;line-height:1.7;">
								We are happy to confirm that your donation has been received and processed successfully.
								Thank you for supporting our mission and making a meaningful difference.
							</p>

							<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin:0 0 24px;">
								<tr>
									<td style="padding:12px 0;border-bottom:1px solid #e5e7eb;width:40%;font-size:14px;color:#6b7280;">Donation Amount</td>
									<td style="padding:12px 0;border-bottom:1px solid #e5e7eb;font-size:14px;font-weight:700;"><%= locals.amount || 'N/A' %></td>
								</tr>
								<tr>
									<td style="padding:12px 0;border-bottom:1px solid #e5e7eb;font-size:14px;color:#6b7280;">Donation Date</td>
									<td style="padding:12px 0;border-bottom:1px solid #e5e7eb;font-size:14px;"><%= locals.date || new Date().toLocaleDateString() %></td>
								</tr>
								<tr>
									<td style="padding:12px 0;border-bottom:1px solid #e5e7eb;font-size:14px;color:#6b7280;">Cause / Campaign</td>
									<td style="padding:12px 0;border-bottom:1px solid #e5e7eb;font-size:14px;"><%= locals.campaign || 'General Support' %></td>
								</tr>
								<tr>
									<td style="padding:12px 0;font-size:14px;color:#6b7280;">Transaction ID</td>
									<td style="padding:12px 0;font-size:14px;"><%= locals.transactionId || 'N/A' %></td>
								</tr>
							</table>

							<p style="margin:0 0 24px;font-size:15px;line-height:1.7;">
								If you have any questions or need assistance, please reply to this email and our team will be glad to help.
							</p>

							<a href="<%= locals.appUrl || '#' %>" style="display:inline-block;background:#16a34a;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;font-size:14px;font-weight:700;">Visit Our Website</a>
						</td>
					</tr>
					<tr>
						<td style="padding:20px 32px 32px;color:#6b7280;font-size:12px;line-height:1.6;">
							<p style="margin:0;">With gratitude,<br /><strong>The Team</strong></p>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>
