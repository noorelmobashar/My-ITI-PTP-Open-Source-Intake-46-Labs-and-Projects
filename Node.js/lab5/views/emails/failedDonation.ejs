<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Donation Failed</title>
	</head>
	<body style="margin:0;padding:0;background-color:#f6f8fb;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
		<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f6f8fb;padding:24px 0;">
			<tr>
				<td align="center">
					<table role="presentation" width="600" cellspacing="0" cellpadding="0" style="max-width:600px;width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb;">
						<tr>
							<td style="background-color:#dc2626;padding:24px 32px;color:#ffffff;">
								<h1 style="margin:0;font-size:24px;line-height:1.3;">Donation Failed</h1>
							</td>
						</tr>
						<tr>
							<td style="padding:32px;">
								<p style="margin:0 0 16px;font-size:16px;line-height:1.6;">
									Hello <strong><%= locals.donorName || 'Supporter' %></strong>,
								</p>
								<p style="margin:0 0 16px;font-size:16px;line-height:1.6;">
									We were unable to complete your donation of <strong><%= locals.amount || 'the selected amount' %></strong>.
								</p>
								<% if (locals.failureReason) { %>
									<div style="margin:0 0 20px;padding:16px;background-color:#fef2f2;border-left:4px solid #dc2626;border-radius:8px;">
										<p style="margin:0;font-size:14px;line-height:1.6;color:#991b1b;">
											<strong>Reason:</strong> <%= locals.failureReason %>
										</p>
									</div>
								<% } %>
								<p style="margin:0 0 16px;font-size:16px;line-height:1.6;">
									Please try again using a different payment method or contact your bank if the issue continues.
								</p>
								<p style="margin:0 0 24px;font-size:16px;line-height:1.6;">
									If you need help, contact us at <a href="mailto:<%= locals.supportEmail || 'support@example.com' %>" style="color:#2563eb;text-decoration:none;"><%= locals.supportEmail || 'support@example.com' %></a>.
								</p>
							</td>
						</tr>
						<tr>
							<td style="padding:0 32px 32px;color:#6b7280;font-size:12px;line-height:1.5;">
								<p style="margin:0;">
									Thank you for your support,
									<br />
									<%= locals.organizationName || 'The Team' %>
								</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
