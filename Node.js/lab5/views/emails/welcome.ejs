<!doctype html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<title>Welcome</title>
	</head>
	<body style="margin:0;padding:0;background-color:#f4f6fb;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;s">
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6fb;padding:32px 16px;">
			<tr>
				<td align="center">
					<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 8px 30px rgba(20,35,70,0.08);">
						<tr>
							<td style="background:linear-gradient(90deg,#6c63ff 0%,#00c2ff 100%);padding:28px 32px;color:#ffffff;text-align:left;">
								<h1 style="margin:0;font-size:22px;letter-spacing:-0.2px">Welcome to Our App</h1>
								<p style="margin:6px 0 0;font-size:14px;opacity:0.95">We're excited to have you with us.</p>
							</td>
						</tr>

						<tr>
							<td style="padding:28px 32px 20px;color:#10233b;">
								<p style="margin:0 0 18px;font-size:16px;line-height:1.5;color:#10233b;">Hi <strong><%= name %></strong>,</p>

								<p style="margin:0 0 18px;font-size:15px;color:#374b67;">Welcome aboard — we're thrilled you've joined. Your account is ready and you can sign in to get started exploring features tailored just for you.</p>

								<table role="presentation" cellpadding="0" cellspacing="0" style="margin:22px 0;">
									<tr>
										<td align="center">
											<a href="/users/sign-in" style="display:inline-block;padding:12px 22px;background:#1f6feb;color:#ffffff;border-radius:8px;text-decoration:none;font-weight:600;font-size:15px;box-shadow:0 6px 18px rgba(31,111,235,0.18);">Sign in to your account</a>
										</td>
									</tr>
								</table>

								<p style="margin:0 0 6px;font-size:13px;color:#6d7b90;">If the button doesn't work, copy and paste this link into your browser:</p>
								<p style="word-break:break-all;margin:6px 0 0;font-size:13px;color:#0b2540;"><a href="/users/sign-in" style="color:#1f6feb;text-decoration:underline;">/users/sign-in</a></p>
							</td>
						</tr>

						<tr>
							<td style="background:#fbfcff;padding:18px 32px 26px;color:#6b7a90;font-size:13px;border-top:1px solid #eef2fb;">
								<p style="margin:0 0 8px;">Need help? Reply to this email and we'll assist you.</p>
								<p style="margin:0;color:#9aa6bd;">— The Team</p>
							</td>
						</tr>

						<tr>
							<td style="padding:14px 20px;background:transparent;text-align:center;color:#9aa6bd;font-size:12px;">
								<small>You're receiving this email because you signed up for Our App.</small>
							</td>
						</tr>

					</table>
				</td>
			</tr>
		</table>
	</body>
</html>

