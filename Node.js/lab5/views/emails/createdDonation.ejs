<!doctype html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<title>Donation Received</title>
		<style>
			body { font-family: Arial, Helvetica, sans-serif; background:#f6f6f6; margin:0; padding:20px }
			.card { background:#ffffff; max-width:600px; margin:20px auto; padding:24px; border-radius:8px; box-shadow:0 2px 6px rgba(0,0,0,0.1) }
			.btn { display:inline-block; padding:12px 18px; background:#0b79d0; color:#fff; text-decoration:none; border-radius:6px }
			.muted { color:#666; font-size:14px }
		</style>
	</head>
	<body>
		<div class="card">
			<h2>Thank you for your donation</h2>
			<p class="muted">We have received a donation of <strong><%= amount %> EGP</strong>.</p>
			<p>If you need to view or manage this donation, click the button below:</p>
			<p><a class="btn" href="<%= link %>">View Donation</a></p>
			<hr>
			<p class="muted">If the button doesn't work, copy and paste the following link into your browser:</p>
			<p class="muted"><a href="<%= link %>"><%= link %></a></p>
			<p class="muted">Best regards,<br>Support Team</p>
		</div>
	</body>
</html>
